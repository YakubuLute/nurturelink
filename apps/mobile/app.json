{
  "expo": {
    "name": "NurtureLink",
    "slug": "nurturelink",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08283B"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08283B"
      },
      "package": "com.nurturelink.app",
      "versionCode": 1,
      "minSdkVersion": 26,
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "./plugins/with-op-sqlite",
        {
          "sqlcipher": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "TODO: add EAS project ID after eas init"
      }
    }
  }
}
